# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Serper API
SERPER_API_KEY=your_serper_api_key

# App
NEXT_PUBLIC_APP_URL=https://www.gotopseo.com

# Google OAuth (Optional - use your own Google OAuth app instead of Supabase's)
# To use custom Google OAuth:
# 1. Create OAuth app in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Set Authorized redirect URIs to: https://www.gotopseo.com/api/auth/callback
# 3. Copy Client ID and Secret below
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# PayPal Plans
# Required for subscription checkout. Get these from your PayPal account.
NEXT_PUBLIC_PAYPAL_PLAN_ID_REGULAR=your_paypal_regular_plan_id
NEXT_PUBLIC_PAYPAL_PLAN_ID_ADVANCED=your_paypal_advanced_plan_id
NEXT_PUBLIC_PAYPAL_PLAN_ID_PREMIUM=your_paypal_premium_plan_id
NEXT_PUBLIC_PAYPAL_PLAN_ID_LARGE_AGENCY=your_paypal_large_agency_plan_id
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_API_URL=https://api.paypal.com

# AI Visibility Module
# Server-side flag — gates all /api/ai-visibility/* routes (return 404 when not 'true').
ENABLE_AI_VISIBILITY=false
# Client-side flag — gates UI visibility in the project page. Must be set independently.
# Set BOTH to 'true' to fully enable the module.
NEXT_PUBLIC_ENABLE_AI_VISIBILITY=false
SCRAPELLM_API_KEY=

# Content Module (Articles / WordPress publishing)
# Server-side flag — gates all /api/wordpress/* and /api/content/* routes (404 when not 'true').
ENABLE_CONTENT=false
# Client-side flag — gates the "Content & Articles" section in the project page.
# Set BOTH to 'true' to fully enable the module.
NEXT_PUBLIC_ENABLE_CONTENT=false
# Content Automation (auto topic recommendations + scheduled auto-generate/publish).
# Requires ENABLE_CONTENT=true as well. Ships dark; set BOTH to 'true' to enable.
ENABLE_CONTENT_AUTOMATION=false
NEXT_PUBLIC_ENABLE_CONTENT_AUTOMATION=false
# Internal-link planning (read-only WordPress content/link index + planner dry-run
# + manual draft-only link preview/apply). Requires content automation too.
# Ships dark; the server flag gates the routes, the NEXT_PUBLIC_ one gates the UI.
ENABLE_INTERNAL_LINK_PLANNING=false
NEXT_PUBLIC_ENABLE_INTERNAL_LINK_PLANNING=false
# Optional: cached index TTL in days (default 7).
# INTERNAL_LINK_INDEX_TTL_DAYS=7
# Phase 2J — after the MANUAL "generate now" flow, approved internal links are
# auto-inserted into the fresh DRAFT once (same safe engine + snapshot/rollback as
# manual apply; draft-only; never cron/queue/publish/WordPress). This is ON by
# default when internal-link planning is enabled. Emergency kill-switch only —
# set to true to fully disable auto-insert after manual generation:
# DISABLE_INTERNAL_LINK_AUTO_INSERT_AFTER_MANUAL_GENERATION=true
# Master key for encrypting WordPress Application Passwords at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
CONTENT_CREDENTIALS_ENCRYPTION_KEY=

# ── Stage E1 — Google Search Console (READ-ONLY) ─────────────────────────────
# Read-only ingestion + observability. Completely disconnected from the
# recommendation engine. Ships dark; every connect/assign/sync route fails closed
# unless GSC_READ_ONLY_ENABLED=true. NEVER commit real values.
#
# Server-authoritative feature flag (default false). The NEXT_PUBLIC mirror only
# shows/hides the UI — routes always re-check the server flag.
GSC_READ_ONLY_ENABLED=false
NEXT_PUBLIC_GSC_READ_ONLY_ENABLED=false
# Google OAuth 2.0 web-server client (Google Cloud Console → Credentials → OAuth
# client ID → "Web application"). The ONLY requested scope is
# https://www.googleapis.com/auth/webmasters.readonly.
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
# Exact redirect URI registered on the OAuth client. Must match the deployment
# origin, e.g. https://your-app.example.com/api/gsc/callback . Read from server
# env only — never derived from the request.
GOOGLE_GSC_REDIRECT_URI=
# Master key for encrypting the OAuth REFRESH token at rest (AES-256-GCM).
# Dedicated key (separate from CONTENT_CREDENTIALS_ENCRYPTION_KEY).
# Generate with: openssl rand -hex 32
GSC_TOKEN_ENCRYPTION_KEY=
# Safety cap on rows fetched per window before a run is marked truncated=true.
# Optional; defaults to 50000 when unset.
GSC_MAX_ROWS_PER_WINDOW=50000
# Article generation uses the existing Gemini provider (GEMINI_API_KEY) but a
# STRONGER model than topic suggestions/classification. Strongly recommended for
# premium SEO/GEO article quality:
GEMINI_ARTICLE_MODEL=gemini-2.5-pro
# If unset, article generation falls back to GEMINI_CLASSIFIER_MODEL (a warning
# is logged) to avoid breaking deploys. Topic suggestions keep using the
# classifier/flash model regardless.
# Featured-image generation uses the same GEMINI_API_KEY via the @google/genai
# Interactions API (image response_format). Images are stored in the public
# Supabase Storage bucket "content-article-images" and uploaded to WordPress on
# draft export. If unset, falls back to gemini-3.1-flash-image →
# gemini-3.1-flash-lite-image → gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Auto-generate a featured image right after an article is created (default ON).
# Set to false to skip auto-image (users can still generate it manually in the
# editor). Image failure never blocks article creation.
CONTENT_AUTO_FEATURED_IMAGE=true
# Future phases (article generation providers) — not used yet:
# ANTHROPIC_API_KEY=
# ARTICLE_AI_PROVIDER=anthropic
# ARTICLE_CHEAP_MODEL=claude-haiku-4-5-20251001
# ARTICLE_WRITING_MODEL=claude-sonnet-5
